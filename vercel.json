{
  "crons": [
    {
      "path": "/api/cron-paper-trading",
      "schedule": "30 10 * * *"
    },
    {
      "path": "/api/cron-paper-trading",
      "schedule": "30 12 * * *"
    },
    {
      "path": "/api/cron-newsletter-prepare",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/cron-newsletter",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/backtest-daily-collect",
      "schedule": "5 7 * * 1-5"
    },
    {
      "path": "/api/cron-dividend-payments",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron-active-etf-import",
      "schedule": "30 13 * * 1-5"
    },
    {
      "path": "/api/app-cache",
      "schedule": "0 7 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/cron-paper-trading",
      "destination": "/api/app-cache?type=paper-trading-run"
    },
    {
      "source": "/api/institution-cost",
      "destination": "/api/app-cache?type=institution-cost"
    },
    {
      "source": "/api/twse/:path*",
      "destination": "https://openapi.twse.com.tw/v1/:path*"
    },
    {
      "source": "/api/twse-report/:path*",
      "destination": "https://www.twse.com.tw/exchangeReport/:path*"
    },
    {
      "source": "/api/tpex/:path*",
      "destination": "https://www.tpex.org.tw/openapi/v1/:path*"
    },
    {
      "source": "/api/mis/:path*",
      "destination": "https://mis.twse.com.tw/stock/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
